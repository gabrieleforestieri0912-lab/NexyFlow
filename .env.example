# =============================================
# Nexyflow — Variabili d'ambiente per il deploy
# Copia questo file in .env (.env.local) per lo
# sviluppo e imposta gli stessi valori nelle
# Environment Variables del progetto su Vercel.
# NON committare mai i valori reali.
# =============================================

# --- Supabase (Database + Auth) -----------------
# Da https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SEGRETA — solo lato server, MAI esposta al client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticazione JWT --------------------------
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- AI Provider (chat, analisi, strategia) ------
# Su Vercel il fallback Ollama (localhost) NON funziona.
# Imposta AI_PROVIDER=openai e OPENAI_API_KEY.
# Priorità: AI_PROVIDER > prima API key disponibile > Ollama.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# In alternativa (scegliere uno solo):
#AI_PROVIDER=openrouter
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=
#AI_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=
#AI_PROVIDER=gemini
#GEMINI_API_KEY=
#GEMINI_MODEL=

# --- Google OAuth (Login con Google) --------------
# Da https://console.cloud.google.com > Credenziali > OAuth 2.0
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (Pagamenti) --------------------------
# Da https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Secret del webhook (Stripe Dashboard > Webhooks > event checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Resend (Email transazionali) -----------------
# Da https://resend.com/api-keys
RESEND_API_KEY=
# Email di destinazione per i messaggi dal form /contact
CONTACT_EMAIL=

# --- Google Analytics ------------------------------
NEXT_PUBLIC_GA_ID=

# --- URL pubblica dell'app --------------------------
# In produzione: https://<progetto>.vercel.app (o il dominio custom)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Usata solo se diversa da NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_API_URL=

# --- Social API (opzionali, per dati reali) --------
# YouTube Data API v3
YOUTUBE_API_KEY=
# Instagram (Meta) — app + callback URI assoluti
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Vercel Cron (opzionale) -----------------------
# Segreto usato come Bearer per proteggere gli endpoint /api/cron/*
CRON_SECRET=