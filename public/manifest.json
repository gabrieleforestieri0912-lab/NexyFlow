{
  "manifest_version": 3,
  "name": "NextBrand - AI Personal Branding Assistant",
  "short_name": "NextBrand",
  "version": "0.2.0",
  "default_locale": "it",
  "author": "NextBrand",
  "homepage_url": "https://nextbrand.ai",
  "description": "Assistente AI per il personal branding su Instagram, TikTok e YouTube.",
  "icons": {
    "16": "nextbrand.png",
    "48": "nextbrand.png",
    "128": "nextbrand.png"
  },
  "action": {
    "default_title": "Apri Nextbrand",
    "default_icon": {
      "16": "nextbrand.png",
      "48": "nextbrand.png",
      "128": "nextbrand.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://nextbrand.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Attiva/disattiva la barra laterale"
    }
  }
}
